# 复制为 .env 后按需修改。切勿把真实密钥提交到仓库。

APP_ENV=local
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---------------------------------------------------------------- 数据库
# 本地/测试：SQLite；生产：postgresql
DB_DIALECT=sqlite
SQLITE_PATH=var/cloud_rag.db
# DB_DIALECT=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cloud_rag
# DB_USER=cloud_rag
# DB_PASSWORD=change-me
# DB_SSLMODE=require
# 行级安全（RLS，PG 专属的第二道防线，默认开启）。
# 前置条件：连接角色不能是 SUPERUSER / BYPASSRLS，否则策略被绕过（启动会告警）。
# DB_RLS_ENABLED=true
# 启动时是否由本进程建表/补列/建策略（都属 DDL，需要属主权限）。
# 本地开发保持 true；生产必须 false —— 应用用只 DML 的 rg_app 连接，
# 由部署 Job 以属主身份执行 `python -m rg_contracts.db.migrate` 完成初始化，
# 应用启动只校验 schema（缺表即 fail-fast）。详见 docs/rls.md。
# DB_MIGRATE_ON_STARTUP=false

# ------------------------------------------------------------------ 认证
# dev = 本地账密登录（便于演示）；oidc = 对接公司统一身份
AUTH_MODE=dev
DEV_LOGIN_ENABLED=true
SECRET_KEY=please-generate-a-long-random-value
# 刷新令牌 Cookie 的 Secure 属性（默认 true，仅 HTTPS 发送）。
# 纯 HTTP 部署必须显式改成 false，否则浏览器会静默丢弃 Cookie（登录成功但刷新即掉线）。
# prod 环境强制为 true，配置为 false 会启动失败。
# AUTH_COOKIE_SECURE=true

# OIDC（AUTH_MODE=oidc 时必填 issuer 与 jwks/或由发现端点推导）
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid profile email groups
OIDC_JWKS_URL=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_ROLES_CLAIM=roles
OIDC_GROUPS_CLAIM=groups
OIDC_ORG_CLAIM=org_id

# ------------------------------------------------------- 组织目录（预留）
# static = 内置的静态目录；http / ldap = 对接公司统一身份接口
DIRECTORY_MODE=static
DIRECTORY_HTTP_URL=
DIRECTORY_HTTP_TOKEN=
DIRECTORY_LDAP_URL=
DIRECTORY_LDAP_BASE_DN=
DIRECTORY_LDAP_BIND_DN=
DIRECTORY_LDAP_BIND_PASSWORD=

# ----------------------------------------------------------- 向量与检索
# 内置 BGE-M3：offline = 确定性降级向量（离线可跑）；http = 调用 TEI 服务
EMBEDDING_BACKEND=offline
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_HTTP_URL=http://localhost:8081/embed
EMBEDDING_DIM=1024
RETRIEVAL_BACKEND=auto

# ----------------------------------------------------------------- 安全
SECURITY_MAX_SPAN_DAYS=31
SECURITY_QUERY_BUDGET_PER_HOUR=60
SECURITY_EXPORT_LIMIT=500
SECURITY_CANARY_ENABLED=true
SECURITY_MASK_ENTITIES=true
SECURITY_COARSE_BUCKETS=true
SECURITY_REDACT_OWNER=true
SECURITY_BLOCK_ON_CANARY=true
SECURITY_TOKEN_SALT=please-generate-another-random-value
SECURITY_AUDIT_ENABLED=true

# ------------------------------------------------- 拼图攻击（mosaic）防护
# 攻击者不越权，只用合法权限反复小范围检索，把多个低密级碎片拼出高密级全貌。
# 单次查询都合规，因此必须做跨查询累积视图（检索账本 + 覆盖度 + 敏感维度共现）。
SECURITY_JIGSAW_ENABLED=true
# 同一主体的检索累积窗口（分钟）
SECURITY_JIGSAW_WINDOW_MINUTES=60
# 窗口内同一主体可见唯一分片数上限
SECURITY_JIGSAW_MAX_UNIQUE_CHUNKS=10
# 窗口内同一项目可见分片覆盖率上限（0-1）
SECURITY_JIGSAW_COVERAGE_LIMIT=0.35
# 覆盖率判定的最小可见分片数：小知识库覆盖率天然偏高，低于该值不启用
SECURITY_JIGSAW_MIN_VISIBLE_CHUNKS=8
# 跨查询敏感维度共现数达到该值即判定「可重组出高密级画像」
SECURITY_JIGSAW_COMBO_DIMENSIONS=3
# 命中后处置：coarsen=降密级返回 / deny=拒绝 / none=仅记录
SECURITY_JIGSAW_ACTION=coarsen
# 静默模式：风险只在审计与安全事件留痕，响应体不回显，避免攻击者据此调整策略
SECURITY_JIGSAW_SILENT=true
# 降密级返回时最多保留的片段数
SECURITY_JIGSAW_COARSEN_TOP_K=2
# 检索账本保留天数
SECURITY_JIGSAW_RETENTION_DAYS=7

# ---------------------------------------------------------- 模型网关
# 页面可配置；默认只允许内网主机，公网主机需显式加入白名单
MODEL_GATEWAY_ALLOW_PUBLIC=false
MODEL_ALLOWED_HOSTS=vllm.inference.svc.cluster.local
INTERNAL_INFERENCE_BASE_URL=http://vllm.inference.svc.cluster.local:8000
INTERNAL_INFERENCE_API_KEY=
INTERNAL_INFERENCE_MODEL=deepseek-r1-distill-qwen-14b-int4
PUBLIC_API_KEY=

# ------------------------------------------------------------- 采集
# simulated = 内置模拟数据（演示）；api = 调用真实云 API
COLLECTOR_MODE=simulated
COLLECTOR_TIMEOUT_SECONDS=30
# 模拟 provider 的 GPU 节点数量（按账号 options 里的 gpu_nodes 生效；默认 0，
# 因为既有用例按精确资源数断言）。偶数序号节点利用率 5%、奇数 60%+，用来演示
# D1 利用率/浪费判定。
# 单个云账号的 options 示例：{"resource_count": 45, "gpu_nodes": 4}

# ------------------------------------------------------------- 治理规则
# D1「GPU 利用率浪费」阈值（百分比）：gpu_utilization 低于该值、且
# allocated_gpus > 0 才判定为浪费。指标缺失时判 unknown，不会当成 0 报浪费；
# 阈值不按平台差异化（如需区分，应先把口径写进规则配置再改这里）。
GOVERNANCE_GPU_IDLE_UTIL_THRESHOLD=10.0

# 云平台凭证：密钥不入库，数据库只存 cloud_account.credential_ref（引用名）。
# 命名规则：配了 credential_ref 时只认「{REF}_{NAME}」作用域名，例如账号
# credential_ref=qy-acc-01、逻辑名 QY_ACCESS_KEY_ID，则读 QY_ACC_01_QY_ACCESS_KEY_ID。
# 引用名里的非字母数字字符（- . / : = 空白）统一替换成 _ 并大写。
# 配了引用名时**不会回落**到下面的全局名：缺失即报错，避免多账号静默共用一份密钥。
#   qingcloud : QY_ACCESS_KEY_ID / QY_SECRET_ACCESS_KEY
#   bluking   : BK_APP_CODE / BK_APP_SECRET
#   huaweicloud: HW_ACCESS_KEY / HW_SECRET_KEY
#   tencentcloud: TC_SECRET_ID / TC_SECRET_KEY
# 未配 credential_ref（单账号部署）时沿用历史口径：上面的名字，或
# {PLATFORM}_{NAME}（如 QINGCLOUD_QY_ACCESS_KEY_ID）。
# QY_ACC_01_QY_ACCESS_KEY_ID=
# QY_ACC_01_QY_SECRET_ACCESS_KEY=

# ------------------------------------------------------------- 平台
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
DEMO_SEED=true
